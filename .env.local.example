# Copy this file to .env.local to configure local agent runs.
#
#     cp .env.local.example .env.local
#
# .env.local is ignored by Git and must never hold real credentials.
# It is read by scripts/local/run-task.sh.

# Model provider used for local agent runs.
#
#   false : default Claude model and authentication
#   true  : OpenRouter, whose credentials are loaded from
#           ~/.config/claude-code/openrouter.env
#
USE_OPENROUTER=false
