<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.claude</groupId>
	<artifactId>claude-cicd-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>pipeline-orchestrated</name>
	<description>Agent-assisted, infrastructure-governed CI/CD pipeline delivering a Spring Boot service to Google Cloud Run.</description>
	<url>https://github.com/RodolGiaco/pipeline-orchestrated</url>
	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://opensource.org/licenses/MIT</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<developers>
		<developer>
			<id>RodolGiaco</id>
			<name>Rodolfo Giacomodonatto</name>
			<url>https://github.com/RodolGiaco</url>
		</developer>
	</developers>
	<scm>
		<connection>scm:git:https://github.com/RodolGiaco/pipeline-orchestrated.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/RodolGiaco/pipeline-orchestrated.git</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/RodolGiaco/pipeline-orchestrated</url>
	</scm>
	<properties>
		<java.version>21</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
