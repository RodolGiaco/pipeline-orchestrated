{
  "permissions": {
    "allow": [
      "Read(/src/**)",
      "Read(/pom.xml)",
      "Read(/mvnw)",
      "Read(/.mvn/**)",

      "Edit(/src/**)",
      "Edit(/pom.xml)",

      "Bash(./mvnw -B -ntp test)",
      "Bash(./mvnw -B -ntp verify)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(/.git/**)",

      "Edit(/.claude/**)",
      "Edit(/.github/**)",
      "Edit(/CLAUDE.md)",

      "Edit(/.mvn/**)",
      "Edit(/mvnw)",
      "Edit(/mvnw.cmd)",

      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git tag *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",

      "Bash(gh *)",
      "Bash(sudo *)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(kubectl *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/inject-session-context.sh",
            "args": []
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-main-branch.sh",
            "args": []
          }
        ]
      }
    ]
  }
}